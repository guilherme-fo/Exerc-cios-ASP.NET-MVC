@model Evento
@{
  ViewData["Title"] = "Cadastrar novo evento";
}

<h1>Cadastrar novo evento</h1>

<div asp-validation-summary="All" class="erro"></div>

<form asp-action="Criar" method="post">
  <p>
    <label asp-for="Nome">Nome</label>
    <input asp-for="Nome" />
    <span asp-validation-for="Nome" class="erro"></span>
  </p>

  <p>
    <label asp-for="Descricao">Descrição</label>
    <input asp-for="Descricao" />
    <span asp-validation-for="Descricao" class="erro"></span>
  </p>
  
  <p>
    <label asp-for="Local">Local</label>
    <input asp-for="Local" />
    <span asp-validation-for="Local" class="erro"></span>
  </p>

  <p>
    <label asp-for="DataEvento">Data de Eventos</label>
    <input asp-for="DataEvento" type="date" />
    <span asp-validation-for="DataEvento" class="erro"></span>
  </p>

  <p>
    <label asp-for="QuantidadeVagas">Quantidade de Vagas</label>
    <input asp-for="QuantidadeVagas" type="number" />
    <span asp-validation-for="QuantidadeVagas" class="erro"></span>
  </p>

  <p>
    <label asp-for="ValorIngresso">Valor de ingresso</label>
    <input asp-for="ValorIngresso" type="number" step="0.01" />
    <span asp-validation-for="ValorIngresso" class="erro"></span>
  </p>
  <button type="submit">Salvar</button>
</form>